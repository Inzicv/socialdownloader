{
  "name": "socialdownloader",
  "productName": "Social Downloader",
  "version": "0.1.0",
  "description": "Téléchargeur de médias en ligne, pilote yt-dlp directement (sans serveur local).",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "node scripts/fetch-bins.js && electron-builder --win --x64 --publish never",
    "fetch-bins": "node scripts/fetch-bins.js"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "author": "Inzicv",
  "build": {
    "appId": "io.github.inzicv.socialdownloader",
    "productName": "Social Downloader",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "ui/**",
      "assets/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Social Downloader",
      "artifactName": "SocialDownloader-Setup-${version}.exe"
    },
    "publish": null,
    "extraResources": [
      {
        "from": "vendor/bin",
        "to": "bin"
      }
    ]
  }
}
